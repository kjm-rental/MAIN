# Public browser-safe Supabase values. Obtain these from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# New Supabase projects may use a publishable key instead. The app also
# supports NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY as an alternative.

# Never add SUPABASE_SERVICE_ROLE_KEY or other secret keys to NEXT_PUBLIC_* variables.
# Configure the Turnstile secret only in Supabase Auth CAPTCHA settings.
# Never place a Turnstile secret in this app or any NEXT_PUBLIC_* variable.

# Telegram server-only credentials. Keep real values in .env.local or hosting secrets.
# Bot: @KJMRentalBot. Never prefix these variables with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# Generate a separate secret with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Owner-only bot access: positive private chat ID; no groups or customer recipients.
TELEGRAM_OWNER_CHAT_ID=

# PayMongo TEST ONLY — server-side. Leave disabled until migrations and integration tests pass.
PAYMONGO_TEST_ENABLED=false
# PayMongo routes accept only this dedicated test project and its legacy service-role key.
PAYMONGO_TEST_PROJECT_REF=uuxjymzrtncrnnkvdpjy
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Generate an independent random secret of at least 32 characters for the scheduler.
PAYMONGO_RECONCILIATION_SECRET=
# Exact HTTPS origin, with no trailing slash. Never derive return URLs from request headers.
PAYMONGO_APP_ORIGIN=
SUPABASE_SERVICE_ROLE_KEY=

# PREPARED LIVE integration. Do not set live mode/enable until migration 026
# is approved/applied and production SQL/provider/concurrency checks pass.
# TEST keys are never accepted by the LIVE database path.
PAYMONGO_MODE=test
PAYMONGO_LIVE_ENABLED=false
PAYMONGO_LIVE_SECRET_KEY=
PAYMONGO_LIVE_WEBHOOK_SECRET=
PAYMONGO_LIVE_RECONCILIATION_SECRET=

# Server-side bot check for accountless guest booking submission; never expose this key publicly.
TURNSTILE_SECRET_KEY=

# Enable ONLY after live QRPh provider/webhook/reconciliation/concurrency verification.
# Keep unset/false during rollout; ADMIN also uses this readiness display gate.
NEXT_PUBLIC_QRPH_LIVE_VERIFIED=false
